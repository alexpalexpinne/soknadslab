{
  "name": "soknadslab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent local grant workflow and risk-based quality engineering portfolio",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:lan": "tsx watch server/index.ts --lan",
    "build": "vite build",
    "start": "tsx server/index.ts --built",
    "test:serve": "tsx server/index.ts --built --test",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "typecheck": "tsc --noEmit",
    "test:fast": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep '@smoke|@a11y'",
    "test:browsers": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:fast && npm run build",
    "report": "playwright show-report",
    "analyze:failures": "tsx scripts/analyze-failures.ts",
    "quality:summary": "tsx scripts/quality-summary.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
